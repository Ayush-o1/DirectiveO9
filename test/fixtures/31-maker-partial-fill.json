{
  "name": "31-maker-partial-fill",
  "description": "Incoming aggressive order partially fills resting maker order which remains on book",
  "symbol": "BTC-USDT",
  "tick_size": 1,
  "lot_size": 1,
  "commands": [
    {
      "type": "LIMIT",
      "order_id": 1,
      "participant_id": 101,
      "side": "SELL",
      "price": 100,
      "quantity": 20,
      "seq": 1,
      "ts": 1000
    },
    {
      "type": "LIMIT",
      "order_id": 2,
      "participant_id": 102,
      "side": "BUY",
      "price": 100,
      "quantity": 5,
      "seq": 2,
      "ts": 1001
    }
  ],
  "expected_events": [
    {
      "event": "ORDER_ACCEPTED",
      "order_id": 1,
      "participant_id": 101,
      "symbol": "BTC-USDT",
      "side": "SELL",
      "price": 100,
      "quantity": 20,
      "remaining_qty": 20,
      "seq": 1,
      "ts": 1000
    },
    {
      "event": "TRADE_EXECUTED",
      "trade_id": 1,
      "symbol": "BTC-USDT",
      "price": 100,
      "quantity": 5,
      "maker_order_id": 1,
      "taker_order_id": 2,
      "maker_participant_id": 101,
      "taker_participant_id": 102,
      "taker_side": "BUY",
      "seq": 2,
      "ts": 1001
    },
    {
      "event": "ORDER_FILLED",
      "order_id": 2,
      "participant_id": 102,
      "symbol": "BTC-USDT",
      "side": "BUY",
      "price": 100,
      "filled_qty": 5,
      "seq": 2,
      "ts": 1001
    }
  ],
  "expected_book": {
    "best_bid": null,
    "best_ask": { "price": 100, "total_volume": 15, "order_count": 1 },
    "depth": {
      "bids": [],
      "asks": [{ "price": 100, "quantity": 15, "order_count": 1 }]
    }
  }
}
