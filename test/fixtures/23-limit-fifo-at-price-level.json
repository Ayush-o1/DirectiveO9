      "type": "LIMIT",
      "order_id": 1,
      "participant_id": 101,
      "side": "SELL",
      "price": 100,
      "quantity": 5,
      "seq": 1,
      "ts": 1000
    },
    {
      "type": "LIMIT",
      "order_id": 2,
      "participant_id": 102,
      "side": "SELL",
      "price": 100,
      "quantity": 10,
      "seq": 2,
      "ts": 1001
    },
    {
      "type": "LIMIT",
      "order_id": 3,
      "participant_id": 103,
      "side": "BUY",
      "price": 100,
      "quantity": 8,
      "seq": 3,
      "ts": 1002
    }
  ],
  "expected_events": [
