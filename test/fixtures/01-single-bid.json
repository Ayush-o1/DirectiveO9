{
  "name": "01-single-bid",
  "description": "Places a single bid order on an empty book",
  "symbol": "BTC-USDT",
  "tick_size": 1,
  "lot_size": 1,
  "commands": [
    {
      "type": "ADD",
      "order_id": 1,
      "participant_id": 101,
      "side": "BUY",
      "price": 100,
      "quantity": 10,
      "seq": 1,
      "ts": 1000
    }
  ],
  "expected_events": [
    {
      "event": "ORDER_ACCEPTED",
      "order_id": 1,
      "participant_id": 101,
      "side": "BUY",
      "price": 100,
      "quantity": 10,
      "seq": 1
    }
  ],
  "expected_book": {
    "best_bid": { "price": 100, "total_volume": 10, "order_count": 1 },
    "best_ask": null,
    "depth": {
      "bids": [{ "price": 100, "quantity": 10, "order_count": 1 }],
      "asks": []
    }
  }
}
