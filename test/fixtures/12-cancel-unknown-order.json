{
  "name": "12-cancel-unknown-order",
  "description": "Attempts to cancel an order that does not exist, emitting UNKNOWN_ORDER reject",
  "symbol": "BTC-USDT",
  "tick_size": 1,
  "lot_size": 1,
  "commands": [
    {
      "type": "ADD",
      "order_id": 1,
      "participant_id": 101,
      "side": "BUY",
      "price": 100,
      "quantity": 10,
      "seq": 1,
      "ts": 1000
    },
    {
      "type": "CANCEL",
      "order_id": 999,
      "participant_id": 101,
      "seq": 2,
      "ts": 1001
    }
  ],
  "expected_events": [
    {
      "event": "ORDER_ACCEPTED",
      "order_id": 1,
      "participant_id": 101,
      "side": "BUY",
      "price": 100,
      "quantity": 10,
      "seq": 1
    },
    {
      "event": "COMMAND_REJECTED",
      "code": "UNKNOWN_ORDER",
      "order_id": 999,
      "participant_id": 101,
      "seq": 2
    }
  ],
  "expected_book": {
    "best_bid": { "price": 100, "total_volume": 10, "order_count": 1 },
    "best_ask": null,
    "depth": {
      "bids": [{ "price": 100, "quantity": 10, "order_count": 1 }],
      "asks": []
    }
  }
}
