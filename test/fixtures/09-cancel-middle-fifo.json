      "side": "BUY",
      "price": 100,
      "quantity": 20,
      "seq": 2
    },
    {
      "event": "ORDER_ACCEPTED",
      "order_id": 3,
      "participant_id": 103,
      "side": "BUY",
      "price": 100,
      "quantity": 30,
      "seq": 3
    },
    {
