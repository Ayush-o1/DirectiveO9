  "tick_size": 1,
  "lot_size": 1,
  "commands": [
    {
      "type": "LIMIT",
      "order_id": 1,
      "participant_id": 101,
      "side": "BUY",
      "price": 100,
      "quantity": 10,
      "seq": 1,
      "ts": 1000
    },
    {
      "type": "CANCEL",
      "order_id": 1,
      "participant_id": 101,
      "seq": 2,
      "ts": 1001
    },
    {
      "type": "CANCEL",
      "order_id": 1,
      "participant_id": 101,
      "seq": 3,
      "ts": 1002
    }
  ],
  "expected_events": [
    {
      "event": "ORDER_ACCEPTED",
      "order_id": 1,
      "participant_id": 101,
      "symbol": "BTC-USDT",
      "side": "BUY",
      "price": 100,
      "quantity": 10,
      "remaining_qty": 10,
      "seq": 1,
      "ts": 1000
    },
    {
      "event": "ORDER_CANCELLED",
      "order_id": 1,
      "participant_id": 101,
      "symbol": "BTC-USDT",
      "side": "BUY",
      "price": 100,
      "original_qty": 10,
      "remaining_qty": 10,
      "reason": "CLIENT_CANCEL",
      "seq": 2,
      "ts": 1001
    },
    {
      "event": "ORDER_REJECTED",
      "code": "ALREADY_TERMINAL",
