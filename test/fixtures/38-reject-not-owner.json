{
  "name": "38-reject-not-owner",
  "description": "Cancel command from non-owner participant is rejected with NOT_OWNER",
  "symbol": "BTC-USDT",
  "tick_size": 1,
  "lot_size": 1,
  "commands": [
    {
      "type": "LIMIT",
      "order_id": 1,
      "participant_id": 101,
      "side": "BUY",
      "price": 100,
      "quantity": 10,
      "seq": 1,
      "ts": 1000
    },
    {
      "type": "CANCEL",
      "order_id": 1,
      "participant_id": 999,
      "seq": 2,
      "ts": 1001
    }
  ],
  "expected_events": [
    {
      "event": "ORDER_ACCEPTED",
      "order_id": 1,
      "participant_id": 101,
      "symbol": "BTC-USDT",
      "side": "BUY",
      "price": 100,
      "quantity": 10,
      "remaining_qty": 10,
      "seq": 1,
      "ts": 1000
    },
    {
      "event": "ORDER_REJECTED",
      "code": "NOT_OWNER",
      "order_id": 1,
      "participant_id": 999,
      "seq": 2,
      "ts": 1001
    }
  ],
  "expected_book": {
    "best_bid": { "price": 100, "total_volume": 10, "order_count": 1 },
    "best_ask": null,
    "depth": {
      "bids": [{ "price": 100, "quantity": 10, "order_count": 1 }],
      "asks": []
    }
  }
}
