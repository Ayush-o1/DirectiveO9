      "side": "SELL",
      "price": 100,
      "quantity": 10,
      "seq": 1,
      "ts": 1000
    },
    {
      "type": "LIMIT",
      "order_id": 2,
      "participant_id": 102,
      "side": "BUY",
      "price": 100,
      "quantity": 10,
      "seq": 2,
      "ts": 1001
