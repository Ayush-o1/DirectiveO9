{
  "name": "29-ioc-zero-fill",
  "description": "Immediate-Or-Cancel (IOC) order with price below ask executes zero trades and cancels",
  "symbol": "BTC-USDT",
  "tick_size": 1,
  "lot_size": 1,
  "commands": [
    {
      "type": "LIMIT",
      "order_id": 1,
      "participant_id": 101,
      "side": "SELL",
      "price": 105,
      "quantity": 10,
      "seq": 1,
      "ts": 1000
    },
    {
      "type": "IOC",
      "order_id": 2,
      "participant_id": 102,
      "side": "BUY",
      "price": 100,
      "quantity": 5,
      "seq": 2,
      "ts": 1001
    }
  ],
  "expected_events": [
    {
      "event": "ORDER_ACCEPTED",
      "order_id": 1,
      "participant_id": 101,
      "symbol": "BTC-USDT",
      "side": "SELL",
      "price": 105,
      "quantity": 10,
      "remaining_qty": 10,
      "seq": 1,
      "ts": 1000
    },
    {
      "event": "ORDER_CANCELLED",
      "order_id": 2,
      "participant_id": 102,
      "symbol": "BTC-USDT",
      "side": "BUY",
      "price": 100,
      "original_qty": 5,
      "remaining_qty": 5,
      "reason": "IOC_UNFILLED",
      "seq": 2,
      "ts": 1001
    }
  ],
  "expected_book": {
    "best_bid": null,
    "best_ask": { "price": 105, "total_volume": 10, "order_count": 1 },
    "depth": {
      "bids": [],
      "asks": [{ "price": 105, "quantity": 10, "order_count": 1 }]
    }
  }
}
