      "maker_participant_id": 101,
      "taker_participant_id": 102,
      "taker_side": "BUY",
      "seq": 2,
      "ts": 1001
    },
    {
      "event": "ORDER_FILLED",
      "order_id": 1,
      "participant_id": 101,
      "symbol": "BTC-USDT",
      "side": "SELL",
      "price": 100,
      "filled_qty": 10,
      "seq": 2,
      "ts": 1001
    },
    {
      "event": "ORDER_ACCEPTED",
      "order_id": 2,
      "participant_id": 102,
      "symbol": "BTC-USDT",
      "side": "BUY",
      "price": 100,
      "quantity": 15,
      "remaining_qty": 5,
      "seq": 2,
      "ts": 1001
    }
  ],
  "expected_book": {
    "best_bid": { "price": 100, "total_volume": 5, "order_count": 1 },
    "best_ask": null,
    "depth": {
      "bids": [{ "price": 100, "quantity": 5, "order_count": 1 }],
