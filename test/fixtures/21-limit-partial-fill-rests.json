{
  "name": "21-limit-partial-fill-rests",
  "description": "Aggressive LIMIT BUY partially fills opposite liquidity and remainder rests on book",
  "symbol": "BTC-USDT",
  "tick_size": 1,
  "lot_size": 1,
  "commands": [
    {
      "type": "LIMIT",
      "order_id": 1,
      "participant_id": 101,
      "side": "SELL",
      "price": 100,
      "quantity": 10,
      "seq": 1,
      "ts": 1000
    },
    {
      "type": "LIMIT",
      "order_id": 2,
      "participant_id": 102,
      "side": "BUY",
      "price": 100,
      "quantity": 15,
      "seq": 2,
      "ts": 1001
    }
  ],
  "expected_events": [
    {
      "event": "ORDER_ACCEPTED",
      "order_id": 1,
      "participant_id": 101,
      "symbol": "BTC-USDT",
      "side": "SELL",
      "price": 100,
      "quantity": 10,
      "remaining_qty": 10,
      "seq": 1,
      "ts": 1000
    },
    {
      "event": "TRADE_EXECUTED",
      "trade_id": 1,
      "symbol": "BTC-USDT",
      "price": 100,
      "quantity": 10,
      "maker_order_id": 1,
